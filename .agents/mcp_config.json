{
  "mcpServers": {
    "quarkus-agent": {
      "command": "jbang",
      "args": [
        "quarkus-agent-mcp@quarkusio"
      ],
      "timeoutSeconds": 300
    },
    "postgres-docker": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://rickmorty:rickmorty@localhost:5432/rick-morty"
      ]
    }
  }
}